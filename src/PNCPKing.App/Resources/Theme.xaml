<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared solid brushes: no effects, animation clocks or external assets. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#243247" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6B7A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E4EAF2" />
    <SolidColorBrush x:Key="BrandBrush" Color="#0B4FA3" />
    <SolidColorBrush x:Key="MarkedPriceBrush" Color="#E3F4E5" />
    <SolidColorBrush x:Key="ValidMarkedPriceBrush" Color="#BCECC5" />
    <SolidColorBrush x:Key="ValidMarkedPriceTextBrush" Color="#104D23" />
    <SolidColorBrush x:Key="ValidMarkedPriceBorderBrush" Color="#2EB85C" />
    <SolidColorBrush x:Key="ValidSelectedPriceBrush" Color="#1874DC" />
    <SolidColorBrush x:Key="ValidSelectedPriceTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ValidSelectedPriceBorderBrush" Color="#70BBFF" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="#09458F" />
    <SolidColorBrush x:Key="BrandPressedBrush" Color="#073A78" />
    <SolidColorBrush x:Key="GoldBrush" Color="#D6A000" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EDF3FA" />
    <SolidColorBrush x:Key="PressedBrush" Color="#DCE8F6" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5F6B7A" />
    <SolidColorBrush x:Key="InfoBrush" Color="#EEF4FB" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#B8CDE6" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF7E5" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E6B85C" />
    <SolidColorBrush x:Key="StartupOverlayBrush" Color="#CCFFFFFF" />

    <!-- Also used by native selection templates (menus, lists, text and grids). -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0B4FA3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#DCE8F6" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#243247" />

    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style x:Key="KeyboardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{StaticResource BrandBrush}"
                               StrokeThickness="1" StrokeDashArray="1,1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Background" Value="{StaticResource BrandBrush}" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandHoverBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Background" Value="{StaticResource BrandBrush}" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandPressedBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandHoverBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandPressedBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search is visually primary, without changing IsDefault/Enter behavior. -->
    <Style x:Key="SearchButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource BrandBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Deliberately separate from editable fields: preserve selectable, borderless information. -->
    <Style x:Key="SelectableInfo" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsUndoEnabled" Value="False" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
        <Setter Property="Background" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True"
                                          TextElement.Foreground="{StaticResource MutedTextBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                            <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{StaticResource BrandBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{StaticResource DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource DividerBrush}" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Padding" Value="3,0" />
    </Style>
</ResourceDictionary>
