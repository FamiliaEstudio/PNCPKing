<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PNCPKing</AssemblyName>
    <RootNamespace>PNCPKing.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Branding\PNCPKing.ico</ApplicationIcon>
    <Version>1.2.6</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Services/InstallGitHubUpdate.ps1"
                      LogicalName="PNCPKing.App.InstallGitHubUpdate.ps1" />
    <ProjectReference Include="../PNCPKing.Infrastructure/PNCPKing.Infrastructure.csproj"
                      SkipGetTargetFrameworkProperties="true" />
    <PackageReference Include="Tesseract" />
    <PackageReference Include="PDFtoImage" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/Branding/PNCPKingLogo.png" />
    <EmbeddedResource Include="Assets/tessdata/por.traineddata"
                      LogicalName="PNCPKing.App.Assets.tessdata.por.traineddata" />
  </ItemGroup>
</Project>
