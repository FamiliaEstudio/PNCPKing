<Window Style="{StaticResource AppWindow}" x:Class="PNCPKing.App.Views.QuotationEvidenceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar Excel e evidências" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <RadioButton Content="Todas as evidências" IsChecked="True" GroupName="EvidenceScope" />
        <RadioButton x:Name="SelectedItemsButton" Content="Evidências de itens selecionados"
                     GroupName="EvidenceScope" Margin="0,8,0,0" Checked="SelectedItems_Checked" />
        <StackPanel IsEnabled="{Binding IsChecked, ElementName=SelectedItemsButton}" Margin="18,6,0,0">
            <Label Content="Números dos itens na planilha" Target="{Binding ElementName=ItemsBox}" Padding="0" />
            <TextBox x:Name="ItemsBox" Margin="0,4,0,0" />
            <TextBlock Text="Use ponto e vírgula para separar itens e intervalos, como em 1-30;57;60-76."
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" MinWidth="90" />
            <Button Content="Continuar" IsDefault="True" MinWidth="95" Click="Continue_Click" />
        </StackPanel>
    </StackPanel>
</Window>
