<Window x:Class="PNCPKing.App.Views.QuotationImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar cotação automática" Height="720" Width="1120"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,10" />
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="ImportItemsGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                      IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Linha" Binding="{Binding SourceRow}" Width="55" />
                    <DataGridTextColumn Header="Pesquisa" Binding="{Binding SearchText}" Width="310" />
                    <DataGridTextColumn Header="Descrição de saída" Binding="{Binding OutputDescription}" Width="200" />
                    <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantity, StringFormat=N4}" Width="100" />
                    <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="120" />
                    <DataGridTextColumn Header="Mínimo" Binding="{Binding MinimumUnitPrice, StringFormat=C4}" Width="100" />
                    <DataGridTextColumn Header="Máximo" Binding="{Binding MaximumUnitPrice, StringFormat=C4}" Width="100" />
                    <DataGridTextColumn Header="Disparos" Binding="{Binding BatchCount}" Width="70" />
                    <DataGridTextColumn Header="Preços na cesta" Binding="{Binding RequestedBasketSize}" Width="105" />
                </DataGrid.Columns>
            </DataGrid>
            <Button Grid.Row="1" Content="Escolher colunas"
                    HorizontalAlignment="Right" Margin="0,5,0,0"
                    Click="ChooseColumns_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cotação existente" VerticalAlignment="Center" />
            <ComboBox x:Name="ProjectComboBox" Grid.Column="1" ItemsSource="{Binding Projects}"
                      DisplayMemberPath="Name" />
            <TextBlock Grid.Column="2" Text="Ou nome da nova cotação" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="NewProjectNameTextBox" Grid.Column="3" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Excel simplificado de saída" VerticalAlignment="Center" />
            <TextBox x:Name="OutputPathTextBox" Grid.Column="1" IsReadOnly="True" />
            <Button Grid.Column="2" Content="Escolher…" Click="BrowseOutput_Click" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" IsCancel="True" MinWidth="100" />
            <Button Content="Criar e iniciar" IsDefault="True" MinWidth="125" Click="Accept_Click" />
        </StackPanel>
    </Grid>
</Window>
