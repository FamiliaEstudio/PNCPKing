<Window x:Class="PNCPKing.App.Views.GuardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PNCP King — PNCP Guard"
        Width="780" Height="560" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22" FontWeight="SemiBold" Text="PNCP Guard" />
        <TextBlock Grid.Row="1" Margin="0,6,0,14" TextWrapping="Wrap"
                   Text="O PNCP King cria uma campanha finita usando somente o índice local. Cada computador recebe um plano sem sobreposição e devolve pacotes de listas de itens pela pasta sincronizada; preços são consultados somente nas pesquisas relevantes." />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Raiz local do Google Drive" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="RootTextBox" Grid.Column="1" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Selecionar…" Click="BrowseRoot_Click" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Trabalhadores e pesos" Margin="0,0,7,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,7"
                               Text="Uma linha por computador, no formato Nome|Peso. O mesmo nome preserva o identificador nas próximas campanhas." />
                    <TextBox x:Name="WorkersTextBox" Grid.Row="1" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                             Text="Casa|1&#x0a;Serviço|1" />
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Operações" Margin="7,0,0,0">
                <StackPanel Margin="10">
                    <Button Content="Gerar/substituir campanha" Click="GenerateCampaign_Click"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,15"
                               Text="Gera um plano imutável para cada trabalhador. Apenas contratações ausentes, incompletas ou desatualizadas entram na campanha." />
                    <Button Content="Importar pasta do PNCP Guard" Click="ImportPackages_Click"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Valida e importa todos os pacotes prontos. Arquivos .partial são ignorados; pacotes repetidos não duplicam dados." />
                </StackPanel>
            </GroupBox>
        </Grid>

        <Border Grid.Row="4" Background="#EEF4FA" BorderBrush="#AFC7DE" BorderThickness="1"
                CornerRadius="4" Padding="10">
            <TextBlock x:Name="StatusTextBlock" Text="Pronto." TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
