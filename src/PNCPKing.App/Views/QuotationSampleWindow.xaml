<Window x:Class="PNCPKing.App.Views.QuotationSampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usar amostra em uma cotação" Height="650" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="175" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="145" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="A amostra será copiada para o projeto e as cestas serão calculadas localmente, sem novas chamadas ao PNCP."
                   TextWrapping="Wrap" Margin="0,0,0,14" />

        <TextBlock Grid.Row="1" Text="Projeto existente" VerticalAlignment="Center" />
        <ComboBox x:Name="ProjectComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                  ItemsSource="{Binding Projects}" DisplayMemberPath="Name" />

        <TextBlock Grid.Row="2" Text="Ou nome de novo projeto" VerticalAlignment="Center" />
        <TextBox x:Name="NewProjectNameTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" />

        <TextBlock Grid.Row="3" Text="Descrição solicitada" VerticalAlignment="Center" />
        <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                 TextWrapping="Wrap" AcceptsReturn="True" Height="65" VerticalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="4" Text="Quantidade e unidade" VerticalAlignment="Center" />
        <TextBox x:Name="QuantityTextBox" Grid.Row="4" Grid.Column="1" />
        <TextBox x:Name="UnitTextBox" Grid.Row="4" Grid.Column="2" ToolTip="Ex.: pacote, caixa, unidade" />

        <TextBlock Grid.Row="5" Text="Faixa unitária opcional" VerticalAlignment="Center" />
        <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MinimumPriceTextBox" ToolTip="Preço mínimo inclusivo" />
            <TextBlock Grid.Column="1" Text="a" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox x:Name="MaximumPriceTextBox" Grid.Column="2" ToolTip="Preço máximo inclusivo" />
        </Grid>

        <GroupBox Grid.Row="6" Grid.ColumnSpan="3" Header="Peso de cada critério — total fixo de 100%" Margin="0,14,0,0">
            <Grid Margin="10,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Descrição" VerticalAlignment="Center" />
                <Slider x:Name="DescriptionWeightSlider" Grid.Column="1" Tag="0" Minimum="0" Maximum="100"
                        TickFrequency="1" IsSnapToTickEnabled="True" Value="50" />
                <TextBlock Grid.Column="2" Text="{Binding ElementName=DescriptionWeightSlider, Path=Value, StringFormat={}{0:N0}%}" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="1" Text="Unidade/embalagem" VerticalAlignment="Center" />
                <Slider x:Name="UnitWeightSlider" Grid.Row="1" Grid.Column="1" Tag="1" Minimum="0" Maximum="100"
                        TickFrequency="1" IsSnapToTickEnabled="True" Value="20" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=UnitWeightSlider, Path=Value, StringFormat={}{0:N0}%}" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="2" Text="Quantidade" VerticalAlignment="Center" />
                <Slider x:Name="QuantityWeightSlider" Grid.Row="2" Grid.Column="1" Tag="2" Minimum="0" Maximum="100"
                        TickFrequency="1" IsSnapToTickEnabled="True" Value="10" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ElementName=QuantityWeightSlider, Path=Value, StringFormat={}{0:N0}%}" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="3" Text="Proximidade" VerticalAlignment="Center" />
                <Slider x:Name="ProximityWeightSlider" Grid.Row="3" Grid.Column="1" Tag="3" Minimum="0" Maximum="100"
                        TickFrequency="1" IsSnapToTickEnabled="True" Value="15" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ElementName=ProximityWeightSlider, Path=Value, StringFormat={}{0:N0}%}" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="4" Text="Atualidade" VerticalAlignment="Center" />
                <Slider x:Name="RecencyWeightSlider" Grid.Row="4" Grid.Column="1" Tag="4" Minimum="0" Maximum="100"
                        TickFrequency="1" IsSnapToTickEnabled="True" Value="5" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ElementName=RecencyWeightSlider, Path=Value, StringFormat={}{0:N0}%}" HorizontalAlignment="Right" />
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Margin="0,14,0,0" Foreground="#5F6871"
                   Text="Com uma faixa preenchida, somente os preços dentro desses limites serão copiados para comparação. Sem faixa, todos os resultados homologados ativos coletados serão usados." TextWrapping="Wrap" />

        <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" MinWidth="95" />
            <Button Content="Criar cotação" IsDefault="True" MinWidth="120" Click="Accept_Click" />
        </StackPanel>
    </Grid>
</Window>
