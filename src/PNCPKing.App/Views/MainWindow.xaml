<Window x:Class="PNCPKing.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PNCPKing.Core.Models;assembly=PNCPKing.Core"
        xmlns:services="clr-namespace:PNCPKing.App.Services"
        Title="PNCP King" Width="1540" Height="940" MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
    <Grid Margin="10" IsEnabled="{Binding IsApplicationReady}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="PNCP King" FontSize="28" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="4,0,20,0" />
                <Button Content="Calcular tamanho" Command="{Binding CalculatePreflightCommand}" />
                <Button Content="Baixar/atualizar dados" Command="{Binding StartSyncCommand}" />
                <Button Content="{Binding PauseIndexButtonText}" Command="{Binding PauseSyncCommand}" />
                <Button Content="Cancelar índice" Command="{Binding CancelIndexCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Exportar backup" Command="{Binding ExportBackupCommand}" />
                <Button Content="Importar backup" Command="{Binding ImportBackupCommand}" />
                <Button Content="Logs de diagnóstico" Command="{Binding OpenDiagnosticLogsCommand}"
                        ToolTip="Abre a pasta com os logs que podem ser copiados para análise." />
                <Button Content="Relatório de desempenho" Command="{Binding ExportPerformanceReportCommand}"
                        ToolTip="Exporta medições locais e anônimas desta execução em JSON e TXT." />
                <Button Content="Comparar desempenho" Command="{Binding ComparePerformanceReportCommand}"
                        ToolTip="Compara esta execução com um relatório-base e calcula os ganhos." />
                <Button Content="Limpar cache permanente" Command="{Binding ClearCacheCommand}" />
                <Button Content="Limpar cache de documentos" Command="{Binding ClearDocumentCacheCommand}"
                        ToolTip="Remove anexos e índices de texto locais sem alterar o banco, relatórios ou PDFs em Downloads." />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#FFF7E5" BorderBrush="#E6B85C"
                BorderThickness="1" CornerRadius="4" Padding="9" Margin="3,7,3,3">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Prévia obrigatória da primeira carga" />
                <TextBlock Text="{Binding PreflightSummary}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#C9D3DD" BorderThickness="1" CornerRadius="4"
                Padding="8" Margin="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Cobertura do índice - mais antigo à esquerda, mais novo à direita"
                               FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CoverageSummary}"
                               HorizontalAlignment="Right" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,1,0,6"
                      ToolTip="Índice e preços compartilham no máximo duas chamadas. Preços visíveis têm prioridade, mas o índice continua recebendo oportunidades.">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#9AA1A8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIndexBusy}" Value="True">
                                            <Setter Property="Background" Value="#2F80D0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsIndexPaused}" Value="True">
                                            <Setter Property="Background" Value="#E6A23C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding IndexActivityText}" VerticalAlignment="Center" MinWidth="235" />
                        <ProgressBar Width="125" Height="8" Margin="8,0,0,0"
                                     IsIndeterminate="{Binding IsIndexTransferActive}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#9AA1A8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPriceTransferActive}" Value="True">
                                            <Setter Property="Background" Value="#7A5BC7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding PriceActivityText}" VerticalAlignment="Center" MinWidth="185" />
                        <ProgressBar Width="125" Height="8" Margin="8,0,0,0"
                                     IsIndeterminate="{Binding IsPriceTransferActive}" />
                    </StackPanel>
                </Grid>
                <ItemsControl Grid.Row="2" ItemsSource="{Binding CoverageDays}"
                              ToolTipService.ShowDuration="30000">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="365" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0.25,0" ToolTip="{Binding ToolTip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#BFC5CC" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CoverageStatus.Partial}">
                                                <Setter Property="Background" Value="#E6B84E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CoverageStatus.Downloading}">
                                                <Setter Property="Background" Value="#3C8DDE" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CoverageStatus.Complete}">
                                                <Setter Property="Background" Value="#36A269" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CoverageStatus.AssumedComplete}">
                                                <Setter Property="Background" Value="#70B98D" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CoverageStatus.Failed}">
                                                <Setter Property="Background" Value="#D9534F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="3" BorderBrush="#D6DDE4" BorderThickness="0,1,0,0"
                        Margin="0,8,0,6" Padding="0,8,0,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#9AA1A8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PriceCacheStatus}" Value="{x:Static models:PriceCacheStatus.Downloading}">
                                                <Setter Property="Background" Value="#2F80D0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PriceCacheStatus}" Value="{x:Static models:PriceCacheStatus.Paused}">
                                                <Setter Property="Background" Value="#E6A23C" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PriceCacheStatus}" Value="{x:Static models:PriceCacheStatus.Complete}">
                                                <Setter Property="Background" Value="#36A269" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PriceCacheStatus}" Value="{x:Static models:PriceCacheStatus.Failed}">
                                                <Setter Property="Background" Value="#D9534F" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PriceCacheStatus}" Value="{x:Static models:PriceCacheStatus.InsufficientSpace}">
                                                <Setter Property="Background" Value="#D9534F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="Itens e preços homologados — últimos 90 dias"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PriceCacheActivityText, Mode=OneWay}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="#5F6871" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Estimar e ativar" Command="{Binding EstimateAndActivatePriceCacheCommand}" />
                            <Button Content="{Binding PausePriceCacheButtonText, Mode=OneWay}" Command="{Binding PausePriceCacheCommand}" />
                            <Button Content="Cancelar ciclo" Command="{Binding CancelPriceCacheCommand}" />
                            <Button Content="Desativar" Command="{Binding DisablePriceCacheCommand}" />
                            <Button Content="Remover cache" Command="{Binding RemovePriceCacheCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PriceCacheSummary, Mode=OneWay}" TextWrapping="Wrap"
                               ToolTip="Pesquisas e cotações têm prioridade; o cache usa somente oportunidades livres da API PNCP." />
                    <ProgressBar Grid.Column="1" Height="9" Minimum="0" Maximum="100"
                                 Value="{Binding PriceCacheProgress, Mode=OneWay}" Margin="12,2,0,0" />
                </Grid>

                <Border Grid.Row="5" BorderBrush="#D6DDE4" BorderThickness="0,1,0,0"
                        Margin="0,8,0,6" Padding="0,8,0,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Catálogo oficial CATMAT/CATSER" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CatalogActivityText}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Foreground="#5F6871" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Atualizar agora" Command="{Binding UpdateCatalogCommand}" />
                            <Button Content="{Binding PauseCatalogButtonText}" Command="{Binding PauseCatalogCommand}" />
                            <Button Content="Cancelar" Command="{Binding CancelCatalogCommand}" />
                            <Button Content="Editar equivalências" Click="CatalogDictionary_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding CatalogCoverage}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="430" Margin="0,0,14,0">
                                    <DockPanel>
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                Background="{Binding Color}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <ProgressBar Height="7" Minimum="0" Maximum="100"
                                                 Value="{Binding Percentage, Mode=OneWay}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding CatalogProgressText}" TextWrapping="Wrap"
                                   HorizontalAlignment="Right" />
                        <ProgressBar Height="7" Minimum="0" Maximum="100"
                                     Value="{Binding CatalogProgress, Mode=OneWay}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="185" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QueryTextBox" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Sintaxe: café + filtro (E); café OU chá; -cafeteira; &quot;café torrado&quot;; &quot;pacote (unidade); C:(material escolar, expediente) prioriza títulos de contratações."
                         VerticalContentAlignment="Center" FontSize="15"
                         PreviewKeyDown="QueryTextBox_PreviewKeyDown" />
                <CheckBox Grid.Column="1" Content="Sweet Code" IsChecked="{Binding SweetCodeEnabled}"
                          VerticalAlignment="Center" Margin="8,0,4,0" />
                <Button Grid.Column="2" Content="Editar" Command="{Binding ManageSweetCodesCommand}"
                        ToolTip="Cole e organize um Sweet Code por linha." />
                <Popup x:Name="SweetCodePopup" PlacementTarget="{Binding ElementName=QueryTextBox}"
                       Placement="Bottom" IsOpen="{Binding HasSweetCodeSuggestions, Mode=OneWay}"
                       AllowsTransparency="True" StaysOpen="False">
                    <Border Background="White" BorderBrush="#8091A3" BorderThickness="1"
                            Padding="3" Width="620" MaxHeight="260">
                        <ListBox x:Name="SweetCodeList" ItemsSource="{Binding SweetCodeSuggestions}"
                                 SelectedItem="{Binding SelectedSweetCodeSuggestion}"
                                 MouseDoubleClick="SweetCodeList_MouseDoubleClick"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Popup>
            </Grid>
            <ComboBox Grid.Column="1" ItemsSource="{Binding GeoFilters}"
                      SelectedItem="{Binding SelectedGeoFilter}" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding DateRanges}"
                      SelectedItem="{Binding SelectedDateRange}" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption}" />
            <DatePicker Grid.Column="4" SelectedDate="{Binding CustomStartDate}"
                        IsEnabled="{Binding IsCustomDateRange}" ToolTip="Data inicial" />
            <DatePicker Grid.Column="5" SelectedDate="{Binding CustomEndDate}"
                        IsEnabled="{Binding IsCustomDateRange}" ToolTip="Data final" />
            <Button Grid.Column="6" Content="Pesquisar" Command="{Binding SearchCommand}" MinWidth="105" />
        </Grid>

        <Grid Grid.Row="4" Margin="3,2,3,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="65" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Faixa unitária homologada ativa:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding MinimumPriceText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Preço mínimo inclusivo" />
            <TextBox Grid.Column="2" Text="{Binding MaximumPriceText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Preço máximo inclusivo" />
            <Button Grid.Column="3" Content="Aplicar faixa" Command="{Binding ApplyPriceFilterCommand}" />
            <TextBox Grid.Column="4" Text="{Binding BatchCount, UpdateSourceTrigger=LostFocus}"
                     HorizontalContentAlignment="Center" ToolTip="1 a 100 lotes de 50 contratações" />
            <Button Grid.Column="5" Content="Mostrar valores das próximas contratações" Command="{Binding FireBatchesCommand}"
                    ToolTip="Examina os próximos lotes de 50 contratações e revela todos os itens compatíveis." />
            <Button Grid.Column="6" Content="Parar preços" Command="{Binding StopItemSearchCommand}" />
            <TextBlock Grid.Column="7" Text="{Binding ItemSearchSummary}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="8,0" ToolTip="{Binding ItemSearchSummary}" />
            <StackPanel Grid.Column="8" VerticalAlignment="Center">
                <TextBlock Text="Progresso da pesquisa de preços" FontSize="10"
                           Foreground="#5F6871" HorizontalAlignment="Center" />
                <ProgressBar Height="10" Minimum="0" Maximum="100"
                             Value="{Binding PriceSearchProgress, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="5" SelectedIndex="{Binding SelectedResultsTabIndex}" Margin="3">
            <TabItem Header="Itens encontrados e preços homologados">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ItemResultsGrid" ItemsSource="{Binding ItemSearchRows}"
                              SelectedItem="{Binding SelectedItemSearchRow}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              FrozenColumnCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                        <Setter Property="Background" Value="#FFFFE4E4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Publicação" Binding="{Binding Contract.PublicationDate, StringFormat=dd/MM/yyyy}" Width="95" />
                            <DataGridTextColumn Header="UF" Binding="{Binding Contract.Uf}" Width="42" />
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Item.Description}" Width="380" />
                            <DataGridTextColumn Header="Unidade" Binding="{Binding Item.Unit}" Width="105" />
                            <DataGridTextColumn Header="Quantidade" Binding="{Binding HomologatedQuantity, StringFormat=N4}" Width="115" />
                            <DataGridTextColumn Header="CNPJ/NI" Binding="{Binding SupplierTaxId}" Width="145" />
                            <DataGridTextColumn Header="Empresa" Binding="{Binding Supplier}" Width="220" />
                            <DataGridTextColumn Header="Unitário homologado" Binding="{Binding HomologatedUnitValue, StringFormat=C4}" Width="145" />
                            <DataGridTextColumn Header="Total homologado" Binding="{Binding HomologatedTotalValue, StringFormat=C4}" Width="135" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Situação" Binding="{Binding DisplayStatus}" Width="190" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Unidade administrativa informada no PNCP" Binding="{Binding Contract.Municipality}" Width="210" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Distância de Ribeirão" Binding="{Binding DistanceFromRibeiraoKilometers, StringFormat={}{0:N1} km}" Width="135" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Contratação PNCP" Binding="{Binding Contract.PncpId}" Width="175" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Item" Binding="{Binding Item.ItemNumber}" Width="58" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Resultado" Binding="{Binding ResultDate, StringFormat=dd/MM/yyyy}" Width="90" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Objeto da contratação" Binding="{Binding Contract.Object}" Width="380" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Órgão" Binding="{Binding Contract.Organization}" Width="190" Visibility="Collapsed" />
                            <DataGridTemplateColumn Header="Ação" Width="245"
                                                    services:DataGridColumnLayoutService.Key="actions">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Abrir no PNCP" Padding="6,2" MinHeight="25"
                                                    Command="{Binding DataContext.OpenPncpCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding Contract}" />
                                            <Button Content="Acessar documentos" Padding="6,2" MinHeight="25"
                                                    Command="{Binding DataContext.AccessItemDocumentsCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="1" Margin="0,5,0,0">
                        <TextBlock Text="{Binding ItemSearchRows.Count, StringFormat=Linhas visíveis: {0:N0}}"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Escolher colunas" Click="ChooseColumns_Click"
                                    Tag="{Binding ElementName=ItemResultsGrid}"
                                    ToolTip="Personalize visibilidade, ordem e largura; o layout será mantido nos próximos usos." />
                            <Button Content="Usar esta amostra em uma cotação"
                                    Command="{Binding UseQuotationSampleCommand}" />
                            <Button Content="Criar/adicionar à cesta manual"
                                    Click="CreateManualBasket_Click"
                                    ToolTip="Use Ctrl ou Shift para selecionar vários preços homologados." />
                            <Button Content="Abrir contratação no PNCP" Command="{Binding OpenPncpCommand}"
                                    CommandParameter="{Binding SelectedItemSearchRow.Contract}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Contratações e cache permanente">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="57*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding ContractResults}" SelectedItem="{Binding SelectedContract}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Publicação" Binding="{Binding PublicationDate, StringFormat=dd/MM/yyyy}" Width="95" />
                                <DataGridTextColumn Header="UF" Binding="{Binding Uf}" Width="42" />
                                <DataGridTextColumn Header="Unidade administrativa informada no PNCP" Binding="{Binding Municipality}" Width="210" />
                                <DataGridTextColumn Header="Modalidade" Binding="{Binding ModalityName}" Width="165" />
                                <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="Objeto" Binding="{Binding Object}" Width="*" MinWidth="350" />
                                <DataGridTextColumn Header="Órgão" Binding="{Binding Organization}" Width="210" />
                                <DataGridTextColumn Header="Total homologado geral" Binding="{Binding TotalHomologated, StringFormat=C}" Width="155" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="1" Margin="0,4,0,0">
                            <TextBlock Text="{Binding ContractPageSummary}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Anterior" Command="{Binding PreviousContractPageCommand}" />
                                <Button Content="Próxima" Command="{Binding NextContractPageCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="#DDD" />

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Cache permanente da contratação" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Buscar/atualizar todos os preços" Command="{Binding HydrateCommand}" />
                                <Button Content="Tentar itens pendentes" Command="{Binding RetryPendingCommand}" />
                                <Button Content="Abrir contratação no PNCP" Command="{Binding OpenPncpCommand}"
                                        CommandParameter="{Binding SelectedContract}" />
                                <Button Content="Acessar documentos" Command="{Binding AccessDocumentsCommand}"
                                        CommandParameter="{Binding SelectedContract}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding ItemSummary}" Margin="0,4" TextWrapping="Wrap" />
                        <DataGrid Grid.Row="2" ItemsSource="{Binding ContractItemRows}" AutoGenerateColumns="False"
                                  IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding ItemNumber}" Width="60" />
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" MinWidth="300" />
                                <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="85" />
                                <DataGridTextColumn Header="Situação" Binding="{Binding DisplayStatus}" Width="205" />
                                <DataGridTextColumn Header="Qtd. homologada" Binding="{Binding HomologatedQuantity, StringFormat=N4}" Width="115" />
                                <DataGridTextColumn Header="Unitário homologado" Binding="{Binding HomologatedUnitValue, StringFormat=C4}" Width="145" />
                                <DataGridTextColumn Header="Total homologado" Binding="{Binding HomologatedTotalValue, StringFormat=C4}" Width="135" />
                                <DataGridTextColumn Header="Fornecedor" Binding="{Binding Supplier}" Width="195" />
                                <DataGridTextColumn Header="CNPJ/NI" Binding="{Binding SupplierTaxId}" Width="135" />
                                <DataGridTextColumn Header="Data" Binding="{Binding ResultDate, StringFormat=dd/MM/yyyy}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Cotações">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBlock Text="Projeto:" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox Width="260" ItemsSource="{Binding QuotationProjects}"
                                      SelectedItem="{Binding SelectedQuotationProject}" />
                            <Button Content="Nova" Command="{Binding NewQuotationCommand}" />
                            <Button Content="Renomear" Command="{Binding RenameQuotationCommand}" />
                            <Button Content="Excluir cotação" Command="{Binding DeleteQuotationCommand}" />
                            <Button Content="Excluir item" Command="{Binding DeleteQuotationLineCommand}" />
                            <Button Content="Editar nome" Command="{Binding RenameQuotationLineCommand}"
                                    ToolTip="Altera somente o nome visível; pesquisas, preços e cestas permanecem intactos." />
                            <Button Content="Abrir item" Command="{Binding OpenQuotationItemCommand}" />
                            <Button Content="Importar XLSX" Command="{Binding ImportQuotationCommand}" />
                            <Button Content="Automação com IA" Command="{Binding AiQuotationCommand}" />
                            <Button Content="Retrabalhar prompts com IA" Command="{Binding RefineQuotationPromptsCommand}" />
                            <Button Content="Retomar automação" Command="{Binding ResumeQuotationAutomationCommand}" />
                            <Button Content="Cancelar automação" Command="{Binding CancelQuotationAutomationCommand}" />
                            <Button Content="Pesquisar restritivo" Command="{Binding OpenRestrictiveQuotationSearchCommand}" />
                            <Button Content="Pesquisar intermediário" Command="{Binding OpenIntermediateQuotationSearchCommand}" />
                            <Button Content="Pesquisar amplo" Command="{Binding OpenBroadQuotationSearchCommand}" />
                            <Button Content="Atualizar amostra com a pesquisa atual"
                                    Command="{Binding UpdateQuotationSampleCommand}" />
                            <Button Content="Ajustar pesos do índice"
                                    Command="{Binding AdjustQuotationWeightsCommand}" />
                            <Button Content="Exportar Excel" Command="{Binding ExportQuotationCommand}" />
                            <Button Content="Exportar pacote"
                                    Command="{Binding ExportQuotationPackageCommand}"
                                    ToolTip="Salva a cotação selecionada com preços, cestas, pesquisas e prints." />
                            <Button Content="Importar pacote"
                                    Command="{Binding ImportQuotationPackageCommand}"
                                    ToolTip="Importa um arquivo portátil .pncpcotacao sem substituir o banco inteiro." />
                            <Button Content="Escolher colunas — itens" Click="ChooseColumns_Click"
                                    Tag="{Binding ElementName=QuotationLinesGrid}"
                                    ToolTip="Personalize visibilidade, ordem e largura; o layout será mantido nos próximos usos." />
                        </WrapPanel>
                        <TextBlock Text="{Binding QuotationSummary}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="62*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="QuotationLinesGrid" ItemsSource="{Binding QuotationLines}"
                                  SelectedItem="{Binding SelectedQuotationLine}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  MouseDoubleClick="QuotationLinesGrid_MouseDoubleClick"
                                  PreviewKeyDown="QuotationLinesGrid_PreviewKeyDown"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome do item" Binding="{Binding Description}" Width="230" MinWidth="180" />
                                <DataGridTextColumn Header="Descrição técnica" Binding="{Binding TechnicalDescription}" Width="230" />
                                <DataGridTextColumn Header="CATMAT/CATSER" Binding="{Binding CatalogCode}" Width="115" />
                                <DataGridTextColumn Header="Restritivo" Binding="{Binding RestrictiveSearchText}" Width="220" />
                                <DataGridTextColumn Header="Intermediário" Binding="{Binding IntermediateSearchText}" Width="200" />
                                <DataGridTextColumn Header="Amplo" Binding="{Binding BroadSearchText}" Width="180" />
                                <DataGridTextColumn Header="Nível ativo" Binding="{Binding ActivePromptLevel}" Width="95" />
                                <DataGridTextColumn Header="Contratos no nível" Binding="{Binding ContractsAtActiveLevel}" Width="105" />
                                <DataGridTextColumn Header="Qtd." Binding="{Binding RequestedQuantity, StringFormat=N4}" Width="72" />
                                <DataGridTextColumn Header="Unidade" Binding="{Binding RequestedUnit}" Width="75" />
                                <DataGridTextColumn Header="Amostra" Binding="{Binding CollectedCount}" Width="66" />
                                <DataGridTextColumn Header="Elegíveis" Binding="{Binding EligibleCount}" Width="66" />
                                <DataGridTextColumn Header="Duplicados" Binding="{Binding DuplicateCount}" Width="72" />
                                <DataGridTextColumn Header="Descartados" Binding="{Binding RejectedCount}" Width="75" />
                                <DataGridTextColumn Header="Cestas" Binding="{Binding BasketCount}" Width="62" />
                                <DataGridTextColumn Header="Alvo auto." Binding="{Binding RequestedBasketSize}" Width="72" />
                                <DataGridTextColumn Header="Estimativa unit." Binding="{Binding EstimatedUnitPrice, StringFormat=C4}" Width="105" />
                                <DataGridTextColumn Header="Estimativa total" Binding="{Binding EstimatedTotalPrice, StringFormat=C4}" Width="105" />
                                <DataGridTextColumn Header="Faixa estimada" Binding="{Binding EstimateStage}" Width="115" />
                                <DataGridTextColumn Header="Contratos exam." Binding="{Binding ContractsExamined}" Width="95" />
                                <DataGridTextColumn Header="Lotes feitos" Binding="{Binding BatchesCompleted}" Width="78" />
                                <DataGridTextColumn Header="Versão" Binding="{Binding SampleVersion}" Width="58" />
                                <DataGridTextColumn Header="Amostra em" Binding="{Binding SampledAt, StringFormat=dd/MM/yyyy HH:mm}" Width="122" />
                                <DataGridTextColumn Header="Pesos do índice" Binding="{Binding WeightSummary}" Width="330" />
                                <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="135" />
                                <DataGridTextColumn Header="Automação" Binding="{Binding AutomationStatus}" Width="135" />
                                <DataGridTextColumn Header="Mensagem" Binding="{Binding AutomationMessage}" Width="220" />
                                <DataGridTextColumn Header="Média escolhida/anterior" Binding="{Binding SelectedAveragePrice, StringFormat=C4}" Width="145" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#DDD" />

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="180" />
                            </Grid.RowDefinitions>
                                    <DataGrid x:Name="QuotationBasketsGrid" ItemsSource="{Binding QuotationBaskets}"
                                              SelectedItem="{Binding SelectedQuotationBasket}"
                                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="Background" Value="{Binding Background}" />
                                                <Setter Property="ToolTip" Value="{Binding ValidationMessage}" />
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="78" />
                                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="110" />
                                            <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="105" />
                                            <DataGridTextColumn Header="Preços" Binding="{Binding ReferenceCount}" Width="58" />
                                            <DataGridTextColumn Header="Classificação" Binding="{Binding Tags}" Width="150" />
                                            <DataGridTextColumn Header="Média" Binding="{Binding AveragePrice, StringFormat=C4}" Width="105" />
                                            <DataGridTextColumn Header="Menor" Binding="{Binding MinimumPrice, StringFormat=C4}" Width="100" />
                                            <DataGridTextColumn Header="Maior" Binding="{Binding MaximumPrice, StringFormat=C4}" Width="100" />
                                            <DataGridTextColumn Header="Desvio máx." Binding="{Binding MaximumDeviationPercent, StringFormat={}{0:N2}%}" Width="92" />
                                            <DataGridTextColumn Header="Índice" Binding="{Binding Score, StringFormat=N2}" Width="75" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DockPanel Grid.Row="1" Margin="0,5">
                                        <TextBlock Text="{Binding QuotationBasketPageSummary}" VerticalAlignment="Center" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Escolher colunas — cestas" Click="ChooseColumns_Click"
                                                    Tag="{Binding ElementName=QuotationBasketsGrid}" />
                                            <Button Content="Escolher colunas — referências" Click="ChooseColumns_Click"
                                                    Tag="{Binding ElementName=SelectedBasketReferencesGrid}" />
                                            <Button Content="Página anterior" Command="{Binding PreviousQuotationBasketPageCommand}" />
                                            <Button Content="Próxima página" Command="{Binding NextQuotationBasketPageCommand}" />
                                            <Button Content="Renomear manual" Command="{Binding RenameManualBasketCommand}" />
                                            <Button Content="Excluir manual" Command="{Binding DeleteManualBasketCommand}" />
                                            <Button Content="Confirmar cesta escolhida" Command="{Binding ConfirmQuotationBasketCommand}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel Grid.Row="2" Margin="0,2,0,4">
                                        <TextBlock Text="Preços:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Content="Na cesta" Click="MainScopeInBasket_Click" />
                                        <Button Content="Elegíveis fora" Click="MainScopeOutside_Click" />
                                        <Button Content="Descartados/duplicados" Click="MainScopeRejected_Click" />
                                        <Button Content="Todos" Click="MainScopeAll_Click" />
                                        <TextBlock Text="{Binding QuotationReferenceScopeSummary}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                    </DockPanel>

                                    <DataGrid x:Name="SelectedBasketReferencesGrid" Grid.Row="3"
                                              ItemsSource="{Binding VisibleQuotationReferences}"
                                              SelectedItem="{Binding SelectedVisibleQuotationReference}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              PreviewMouseRightButtonDown="MainReferences_PreviewMouseRightButtonDown"
                                              MouseDoubleClick="MainReferences_MouseDoubleClick"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu x:Name="MainReferenceContextMenu">
                                                <MenuItem Header="Abrir PNCP/site" Click="MainReferenceOpen_Click" />
                                                <MenuItem Header="Acessar documentos" Click="MainReferenceDocuments_Click" />
                                                <MenuItem Header="Ver páginas relevantes" Click="MainReferenceRelevant_Click" />
                                                <Separator />
                                                <MenuItem Header="Adicionar/retirar da cesta" Click="MainReferenceToggle_Click" />
                                                <MenuItem Header="Abrir item detalhado" Click="MainReferenceOpenItem_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Na cesta" Width="72"
                                                                    services:DataGridColumnLayoutService.Key="in-basket">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsInSelectedBasket, Mode=OneWay}"
                                                                  HorizontalAlignment="Center"
                                                                  Click="MainMembership_Click" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Fonte" Binding="{Binding SourceLabel}" Width="82" />
                                            <DataGridTextColumn Header="Publicação/captura"
                                                                Binding="{Binding PublicationDate, StringFormat=dd/MM/yyyy}"
                                                                Width="120" />
                                            <DataGridTextColumn Header="UF" Binding="{Binding Uf}" Width="42" />
                                            <DataGridTextColumn Header="Descrição" Binding="{Binding Description}"
                                                                Width="260" MinWidth="180" />
                                            <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="78" />
                                            <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantity, StringFormat=N4}"
                                                                Width="105" />
                                            <DataGridTextColumn Header="CNPJ/NI" Binding="{Binding SupplierTaxId}" Width="135" />
                                            <DataGridTextColumn Header="Empresa" Binding="{Binding SupplierName}" Width="180" />
                                            <DataGridTextColumn Header="Unitário" Binding="{Binding UnitPrice, StringFormat=C4}" Width="105" />
                                            <DataGridTextColumn Header="Situação" Binding="{Binding State}" Width="90" />
                                            <DataGridTemplateColumn Header="Ações" Width="82"
                                                                    services:DataGridColumnLayoutService.Key="actions">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Ações ▾" Click="MainReferenceActions_Click" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Município" Binding="{Binding Municipality}"
                                                                Width="130" Visibility="Collapsed" />
                                            <DataGridTextColumn Header="Índice" Binding="{Binding AdequacyTotal, StringFormat=N2}"
                                                                Width="70" Visibility="Collapsed" />
                                            <DataGridTextColumn Header="Descrição — índice" Binding="{Binding DescriptionScore, StringFormat=N2}"
                                                                Width="110" Visibility="Collapsed" />
                                            <DataGridTextColumn Header="Unidade — índice" Binding="{Binding UnitScore, StringFormat=N2}"
                                                                Width="105" Visibility="Collapsed" />
                                            <DataGridTextColumn Header="Quantidade — índice" Binding="{Binding QuantityScore, StringFormat=N2}"
                                                                Width="120" Visibility="Collapsed" />
                                            <DataGridTextColumn Header="Proximidade — índice" Binding="{Binding ProximityScore, StringFormat=N2}"
                                                                Width="120" Visibility="Collapsed" />
                                            <DataGridTextColumn Header="Atualidade — índice" Binding="{Binding RecencyScore, StringFormat=N2}"
                                                                Width="110" Visibility="Collapsed" />
                                            <DataGridTextColumn Header="Nível do prompt" Binding="{Binding PromptLevel}"
                                                                Width="105" Visibility="Collapsed" />
                                            <DataGridTextColumn Header="Motivo/explicação" Binding="{Binding Explanation}"
                                                                Width="400" Visibility="Collapsed" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="6">
            <StatusBarItem>
                <StatusBarItem.Style>
                    <Style TargetType="StatusBarItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFileBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StatusBarItem.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding FileOperationProgressText}" MaxWidth="360"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding FileOperationProgressText}" />
                    <ProgressBar Width="135" Height="10" Margin="7,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding OperationProgress, Mode=OneWay}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DocumentProgressText}" MaxWidth="330"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ProgressBar Width="110" Height="10" Margin="7,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding DocumentProgress, Mode=OneWay}" />
                    <Button Content="Cancelar documentos"
                            Command="{Binding CancelDocumentOperationCommand}"
                            Padding="5,1" Margin="0" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding DatasetSummary}" TextTrimming="CharacterEllipsis" MaxWidth="850" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding DataFolder, StringFormat=Pasta: {0}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
        <Border Background="#EAF3FA" BorderBrush="#2F80D0" BorderThickness="1"
                CornerRadius="8" Padding="24" Width="470" HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsInitializing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="PNCP King" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <ProgressBar Height="8" Margin="0,18,0,12" IsIndeterminate="True" />
                <TextBlock Text="{Binding StartupStatus}" TextWrapping="Wrap"
                           TextAlignment="Center" FontSize="14" />
                <Button Content="Cancelar inicialização" Command="{Binding CancelStartupCommand}"
                        HorizontalAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
