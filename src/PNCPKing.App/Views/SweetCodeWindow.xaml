<Window x:Class="PNCPKing.App.Views.SweetCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar Sweet Codes" Height="570" Width="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Cole ou edite expressões de pesquisa. Cada linha não vazia é um Sweet Code independente."
                   TextWrapping="Wrap" />
        <CheckBox x:Name="EnabledCheckBox" Grid.Row="1" Margin="0,10"
                  Content="Ativar sugestões de Sweet Code" />
        <TextBox x:Name="CodesTextBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="False"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="14" TextWrapping="NoWrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" MinWidth="95" />
            <Button Content="Salvar" IsDefault="True" MinWidth="95" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
