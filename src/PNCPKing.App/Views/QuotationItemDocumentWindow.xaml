<Window Style="{StaticResource AppWindow}" x:Class="PNCPKing.App.Views.QuotationItemDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CATMAT e mínimo do item" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="ItemNameText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock Text="CATMAT informado" />
        <TextBox x:Name="CatmatBox" />
        <TextBlock x:Name="CatalogHintText" TextWrapping="Wrap" Margin="0,5,0,12" />
        <TextBlock Text="Quantidade mínima por pedido (valor nominal)" />
        <TextBox x:Name="MinimumBox" />
        <TextBlock Text="Informe uma quantidade inteira positiva. Deixe vazia para usar o percentual escolhido na exportação Word. O valor informado vale também para as cotas principal e reservada."
                   TextWrapping="Wrap" Margin="0,5,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True" MinWidth="100" />
            <Button Content="Salvar" IsDefault="True" Click="Accept_Click" MinWidth="100" />
        </StackPanel>
    </StackPanel>
</Window>
