<Window x:Class="PNCPKing.App.Views.ColumnChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher colunas" Width="460" Height="590"
        MinWidth="360" MinHeight="360" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Marque as colunas visíveis. Selecione uma coluna e escolha sua posição; a grade só mudará ao aplicar."
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <ListBox x:Name="ColumnsList" Grid.Row="1" ItemsSource="{Binding Rows}"
                 SelectionChanged="ColumnsList_SelectionChanged"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Position, StringFormat={}{0}.}" Width="30"
                                   VerticalAlignment="Center" Margin="5,0,0,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Header}" ToolTip="{Binding Header}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="2" Content="Visível" IsChecked="{Binding IsVisible}"
                                  PreviewMouseLeftButtonDown="ColumnCheckBox_PreviewMouseLeftButtonDown"
                                  VerticalAlignment="Center" Margin="6,0,4,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Posição da coluna selecionada:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="PositionComboBox" Width="76" IsEnabled="False"
                      ItemsSource="{Binding Positions}" SelectionChanged="PositionComboBox_SelectionChanged" />
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Content="Restaurar padrão" Click="Reset_Click" DockPanel.Dock="Left"
                    ToolTip="Restaura a largura, a ordem e a visibilidade originais das colunas." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Aplicar" IsDefault="True" Click="Apply_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
