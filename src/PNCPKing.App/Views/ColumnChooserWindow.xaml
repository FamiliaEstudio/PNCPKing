<Window x:Class="PNCPKing.App.Views.ColumnChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher colunas" Width="460" Height="590"
        MinWidth="360" MinHeight="360" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Marque as colunas que devem permanecer visíveis. A grade só será reorganizada ao aplicar."
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible}"
                              Padding="5" MinHeight="30" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button Content="Restaurar padrão" Click="Reset_Click" DockPanel.Dock="Left" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Aplicar" IsDefault="True" Click="Apply_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
