<Window x:Class="PNCPKing.App.Views.SqliteCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avaliar desempenho deste PC" Width="810" Height="610"
        MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Preparando avaliação local de até cinco minutos…"/>
        <ProgressBar x:Name="Activity" Grid.Row="1" Height="5" IsIndeterminate="True" Margin="0,0,0,12"/>
        <TextBox x:Name="Details" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="14"
                 Text="O banco será somente lido. A manutenção ficará suspensa durante a avaliação. Você pode cancelar ou iniciar outra operação. Nenhuma configuração será aplicada automaticamente."/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="Apply" Content="Aplicar recomendação" Click="Apply_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0"/>
            <Button x:Name="Restore" Content="Restaurar padrão" Click="Restore_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0"/>
            <Button x:Name="Cancel" Content="Cancelar avaliação" Click="Cancel_Click" Padding="12,7"/>
        </StackPanel>
    </Grid>
</Window>
